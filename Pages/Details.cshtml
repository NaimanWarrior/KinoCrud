@page
@model KinoCrud.Pages.DetailsModel
@{
    ViewData["Title"] = Model.Movie.Name;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<style>
    body {
        background-color: #121212;
        color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .poster-img {
        width: 100%;
        max-height: 500px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #2d2d2d;
        box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }

    .movie-meta {
        background-color: #1e1e1e;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #2d2d2d;
    }

    .trailer-container {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid #2d2d2d;
    }

        .trailer-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

    .rating-badge {
        background-color: #ffc107;
        color: #000;
        font-weight: bold;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 1.1rem;
        display: inline-block;
    }
</style>

<div class="container py-4">
    <a asp-page="/Index" class="btn btn-outline-secondary mb-4">
        <i class="fa-solid fa-arrow-left me-2"></i> Вернуться к фильму
    </a>

    <div class="row g-4">
        <div class="col-md-4">
            <img src="@Model.Movie.PosterUrl" alt="@Model.Movie.Name" class="poster-img mb-3">
        </div>

        <div class="col-md-8">
            <div class="movie-meta">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h1 class="text-warning fw-bold m-0">@Model.Movie.Name</h1>
                    <div class="rating-badge">
                        ★ @Model.Movie.Rate.ToString("0.0")
                    </div>
                </div>

                <hr class="border-secondary">

                <h5 class="text-white-50 mb-2">Описание</h5>
                <p class="fs-6 text-light" style="line-height: 1.7;">
                    @Model.Movie.Description
                </p>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <h3 class="text-warning mb-3"><i class="fa-solid fa-play me-2"></i> Трейлер к фильму</h3>

            @if (!string.IsNullOrEmpty(Model.EmbedTrailerUrl))
            {
                <div class="trailer-container">
                    <iframe src="@Model.EmbedTrailerUrl"
                            title="Трейлер фильма"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen>
                    </iframe>
                </div>
            }
            else
            {
                <div class="alert alert-dark border-secondary text-secondary">
                    Трейлер для этого фильма пока не добавлен.
                </div>
            }
        </div>
    </div>
</div>
